<main class="page" role="main">
  <h1>{{ page.name }}</h1>
  <ul class="cards">
    {! for entry in pages|selectattr("type", "in", "doc,wiki,link")|selectattr("alive") !}
    <li>
      {! if entry.type == "link" !}
      <a href="{{ entry.url }}" target="_blank" rel="noopener">
      {! else !}
      <a href="/doc/{{ entry.name.lower() }}">
      {! endif !}
        <span>{{ entry.name }}</span>
        <p class="caption">{{ entry.caption }}</p>
      </a>
    </li>
    {! endfor !}
  </ul>

  <h2>Archived</h2>
  <ul class="cards">
    {! for entry in pages|selectattr("type", "in", "doc,wiki,link")|rejectattr("alive") !}
    <li>
      {! if entry.type == "link" !}
      <a href="{{ entry.url }}" target="_blank" rel="noopener">
      {! else !}
      <a href="/doc/{{ entry.name.lower() }}">
      {! endif !}
        <span>{{ entry.name }}</span>
        <p class="caption">{{ entry.caption }}</p>
      </a>
    </li>
    {! endfor !}
  </ul>
</main>
